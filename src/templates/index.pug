extends layout/main.pug
include mixins/navbar.pug

block head
  title #{title} | Preview Realtors

block content
  +navbar('home')
  // ======= Intro Section =======
  .intro.intro-carousel.swiper-container.position-relative.mt-5
    each property in top
      .swiper-slide.carousel-item-a.intro-item.bg-image(style=`background-image: url(${property.picture.url})`)
        .overlay.overlay-a
        .intro-content.display-table
          .table-cell
            .container
              .row
                .col-lg-8
                  .intro-body
                    h1.intro-title.mb-4
                      span.color-b= property.title
                    p.intro-subtitle.intro-price
                      a(href=`/locations/${property._id}`)
                        span.price-a #{property.status} | View
                          span.bi.bi-chevron-right
    //- .swiper-wrapper
    //-   .swiper-slide.carousel-item-a.intro-item.bg-image(style=`background-image: url('/img/slides/1.jpg')`)
    //-     .overlay.overlay-a
    //-     .intro-content.display-table
    //-       .table-cell
    //-         .container
    //-           .row
    //-             .col-lg-8
    //-               .intro-body
    //-                 h1.intro-title.mb-4
    //-                   span.color-text-c For Rent
    //-                 p.intro-subtitle.intro-price
    //-                   a(href=`/locations?type=rent`)
    //-                     span.price-a Rent | View
    //-                       span.bi.bi-chevron-right
    //-   .swiper-slide.carousel-item-b.intro-item.bg-image(style=`background-image: url('/img/slides/2.jpeg')`)
    //-     .overlay.overlay-a
    //-     .intro-content.display-table
    //-       .table-cell
    //-         .container
    //-           .row
    //-             .col-lg-8
    //-               .intro-body
    //-                 h1.intro-title.mb-4
    //-                   span.color-text-c For Sale
    //-                 p.intro-subtitle.intro-price
    //-                   a(href=`/locations?type=sale`)
    //-                     span.price-a Sale | View
    //-                       span.bi.bi-chevron-right
    .swiper-pagination
  main#main
    // ======= Latest Properties Section =======
    section.section-property.section-t8.bg-primary.pb-3
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.color-text-c Popular Properties
              .title-link
                a(href='/locations')
                  span.bi.bi-chevron-right
        #property-carousel.swiper-containerimage
          .swiper-wrapper.mh-100
            each property in popular
              .carousel-item-b.swiper-slide.mh-100
                .card-box-a.card-shadow.mh-100
                  .img-box-a
                    img.img-a.img-fluid(src=property.picture.url alt='')
                  .card-overlay
                    .card-overlay-a-content
                      .card-header-a
                        h2.card-title-a
                          a(href=`/locations/${property._id}`)= property.title
                      .card-body-a
                        .price-box.d-flex
                          span.price-a #{property.status}
                        a.link-a(href=`/locations/${property._id}`)
                          | Click here to view
                          span.bi.bi-chevron-right
              // End carousel item
        .propery-carousel-pagination.carousel-pagination
    // End Latest Properties Section
    section.section-agents.section-t8
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.title-a Our 
                  span.color-b Properties
              .title-link
                a(href='/locations')
                  | All Properties
                  span.bi.bi-chevron-right
        .row
          each property in popular
            .col-md-3.mt-3
              .card
                img.card-img-top(src=property.picture.url)
                .card-body
                  h5.card-title= property.title
                  p.card-text= property.description.substr(0, 30)
                  a.btn(href=`/locations/${property._id}`) View
        .row.mt-5
          .col-xl-4.col-md-6
            a.single_counter(href='/locationstype=sale')
              h3.display-4
                span.color-b #{for_sale}
              p Properties for sale
          .col-xl-4.col-md-6
            a.single_counter(href='/locations?type=rent')
              h3.display-4
                span.color-b #{for_rent}
              p Properties for rent
    // ======= Testimonials Section =======
    section.section-testimonials.section-t8.nav-arrow-a
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.title-a Testimonials
        #testimonial-carousel.swiper-container
          .swiper-wrapper
            .carousel-item-a.swiper-slide
              .testimonials-box
                .row
                  .col-sm-12.col-md-6
                    .testimonial-img
                      img.img-fluid(src='/img/testimonial-1.jpg' alt='')
                  .col-sm-12.col-md-6
                    .testimonial-ico
                      i.bi.bi-chat-quote-fill
                    .testimonials-content
                      p.testimonial-text
                        | We used Preview Realtors to look for a hhouse, and we
                        | cannot say we were disappointed. They were simply
                        | fantastic, and we could never have found our dream
                        | home without their help. Kudos to the team
                    .testimonial-author-box
                      h5.testimonial-author Albert
            // End carousel item
            .carousel-item-a.swiper-slide
              .testimonials-box
                .row
                  .col-sm-12.col-md-6
                    .testimonial-img
                      img.img-fluid(src='/img/testimonial-2.jpg' alt='')
                  .col-sm-12.col-md-6
                    .testimonial-ico
                      i.bi.bi-chat-quote-fill
                    .testimonials-content
                      p.testimonial-text
                        | We used Preview Realtors to look for a hhouse, and we
                        | cannot say we were disappointed. They were simply
                        | fantastic, and we could never have found our dream
                        | home without their help. Kudos to the team.
                    .testimonial-author-box
                      h5.testimonial-author Ian
            // End carousel item
        .testimonial-carousel-pagination.carousel-pagination
    // End Testimonials Section
    // End #main
    include includes/footer.pug
