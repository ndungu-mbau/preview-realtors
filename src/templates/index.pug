extends layout/main.pug
include mixins/navbar.pug

block head
  title #{title} | Preview Realtors

block content
  +navbar('home')
  // ======= Intro Section =======
  .intro.intro-carousel.swiper-container.position-relative.mt-5
    .swiper-wrapper
      each property in top
        .swiper-slide.carousel-item-a.intro-item.bg-image(style=`background-image: url(${property.image.url})`)
          .overlay.overlay-a
          .intro-content.display-table
            .table-cell
              .container
                .row
                  .col-lg-8
                    .intro-body
                      h1.intro-title.mb-4
                        span.color-b= property.title
                      p.intro-subtitle.intro-price
                        a(href=`/properties/${property._id}`)
                          span.price-a #{property.status} | View
                            span.bi.bi-chevron-right
    .swiper-pagination
  main#main
    // ======= Latest Properties Section =======
    section.section-property.section-t8
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.title-a Latest Properties
              .title-link
                a(href='/properties')
                  | All Property
                  span.bi.bi-chevron-right
        #property-carousel.swiper-container
          .swiper-wrapper
            each property in popular
              .carousel-item-b.swiper-slide
                .card-box-a.card-shadow
                  .img-box-a
                    img.img-a.img-fluid(src=property.image.url alt='')
                  .card-overlay
                    .card-overlay-a-content
                      .card-header-a
                        h2.card-title-a
                          a(href=`/properties/${property._id}`)= property.title
                      .card-body-a
                        .price-box.d-flex
                          span.price-a #{property.status}
                        a.link-a(href='#')
                          | Click here to view
                          span.bi.bi-chevron-right
              // End carousel item
        .propery-carousel-pagination.carousel-pagination
    // End Latest Properties Section
    section.section-agents.section-t8
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.title-a Our Properties
        .row
          .col-xl-4.col-md-6
            .single_counter
              h3.display-4
                span.color-b #{for_sale}
              p Properties for sale
          .col-xl-4.col-md-6
            .single_counter
              h3.display-4
                span.color-b #{for_rent}
              p Properties for rent
    // ======= Testimonials Section =======
    section.section-testimonials.section-t8.nav-arrow-a
      .container
        .row
          .col-md-12
            .title-wrap.d-flex.justify-content-between
              .title-box
                h2.title-a Testimonials
        #testimonial-carousel.swiper-container
          .swiper-wrapper
            .carousel-item-a.swiper-slide
              .testimonials-box
                .row
                  .col-sm-12.col-md-6
                    .testimonial-img
                      img.img-fluid(src='/img/testimonial-1.jpg' alt='')
                  .col-sm-12.col-md-6
                    .testimonial-ico
                      i.bi.bi-chat-quote-fill
                    .testimonials-content
                      p.testimonial-text
                        | We used Preview Realtors to look for a hhouse, and we
                        | cannot say we were disappointed. They were simply
                        | fantastic, and we could never have found our dream
                        | home without their help. Kudos to the team
                    .testimonial-author-box
                      img.testimonial-avatar(src='/img/mini-testimonial-1.jpg' alt='')
                      h5.testimonial-author Albert &amp; Erika
            // End carousel item
            .carousel-item-a.swiper-slide
              .testimonials-box
                .row
                  .col-sm-12.col-md-6
                    .testimonial-img
                      img.img-fluid(src='/img/testimonial-2.jpg' alt='')
                  .col-sm-12.col-md-6
                    .testimonial-ico
                      i.bi.bi-chat-quote-fill
                    .testimonials-content
                      p.testimonial-text
                        | We used Preview Realtors to look for a hhouse, and we
                        | cannot say we were disappointed. They were simply
                        | fantastic, and we could never have found our dream
                        | home without their help. Kudos to the team.
                    .testimonial-author-box
                      img.testimonial-avatar(src='/img/mini-testimonial-2.jpg' alt='')
                      h5.testimonial-author Pablo &amp; Emma
            // End carousel item
        .testimonial-carousel-pagination.carousel-pagination
    // End Testimonials Section
    // End #main
    include includes/footer.pug
