mixin navbar(active)
  //  ======= Property Search Section ======= 
  .click-closed
  // / Form Search Star /
  .box-collapse
    .title-box-d
      h3.title-d Search Property
    span.close-box-collapse.right-boxed.bi.bi-x
    .box-collapse-wrap.form
      form.form-a(action='/properties' method='get')
        .row
          .col-md-12.mb-2
            .form-group
              label.pb-2(for='Type') Keyword
              input.form-control.form-control-lg.form-control-a(type='text' placeholder='Keyword' name='keyword')
          .col-md-12.mb-2
            .form-group.mt-3
              label.pb-2(for='Type') Type
              select.form-control.form-select.form-control-a#Type(name='type')
                option(value='') All Type
                option(value='rent') For Rent
                option(value='sale') For Sale
          .col-md-6.mb-2
            .form-group.mt-3
              label.pb-2(for='bedrooms') Bedrooms
              select.form-control.form-select.form-control-a#bedrooms(name='beds')
                option(value='') Any
                option(value='1') 01
                option(value='2') 02
                option(value='3') 03
          .col-md-6.mb-2
            .form-group.mt-3
              label.pb-2(for='bathrooms') Bathrooms
              select.form-control.form-select.form-control-a#bathrooms(name='baths')
                option(value='') Any
                option(value='1') 01
                option(value='2') 02
                option(value='3') 03
          .col-md-6.mb-2
            .form-group.mt-3
              label.pb-2(for='min-price') Min Price
              input.form-control.form-control-a#min-price(type="number" name="min")
          .col-md-6.mb-2
            .form-group.mt-3
              label.pb-2(for='max-price') Max Price
              input.form-control.form-control-a#max-price(type="number" name="max")
          .col-md-12
            button.btn.btn-b(type='submit') Search Property
  //  End Property Search Section
  //  ======= Header/Navbar ======= 
  nav.navbar.navbar-default.navbar-trans.navbar-expand-lg.fixed-top
    .container
      a.navbar-brand.text-brand(href='/')
        img(src='/img/logo.png' alt='logo' height='50')
        | Preview
        span.color-b Realtors
      button.navbar-toggler.collapsed(type='button' data-bs-toggle='collapse' data-bs-target='#navbarDefault' aria-controls='navbarDefault' aria-expanded='false' aria-label='Toggle navigation')
        span
        span
        span
      .navbar-collapse.collapse.justify-content-center#navbarDefault
        ul.navbar-nav
          li.nav-item
            a.nav-link(href='/' class=`${active === 'home' ? 'active': ''}`) Home
          li.nav-item
            a.nav-link(href='/about' class=`${active === 'about' ? 'active': ''}`) About
          li.nav-item
            a.nav-link(href='/contact' class=`${active === 'contact' ? 'active': ''}`) Contact
      button.btn.btn-b-n.navbar-toggle-box.navbar-toggle-box-collapse(type='button' data-bs-toggle='collapse' data-bs-target='#navbarTogglerDemo01')
        i.bi.bi-search
  //  End Header/Navbar 