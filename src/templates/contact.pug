extends layout/main

include mixins/navbar.pug

block head 
  title #{title} | Preview Realtors

block content
  +navbar('contact')
  main#main
    // ======= Intro Single =======
    section.intro-single
      .container
        .row
          .col-md-12.col-lg-8
            .title-single-box
              h1.title-single Contact US
              span.color-text-a We are freely reachable and available to help any day.
          .col-md-12.col-lg-4
            nav.breadcrumb-box.d-flex.justify-content-lg-end(aria-label='breadcrumb')
              ol.breadcrumb
                li.breadcrumb-item
                  a(href='/') Home
                li.breadcrumb-item.active(aria-current='page')
                  | Contact
    // End Intro Single
    // ======= Contact Single =======
    section.contact
      .container
        .row
          .col-sm-12
            .contact-map.box
              #map.contact-map
                iframe(src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.1422937950147!2d-73.98731968482413!3d40.75889497932681!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25855c6480299%3A0x55194ec5a1ae072e!2sTimes+Square!5e0!3m2!1ses-419!2sve!4v1510329142834' width='100%' height='450' frameborder='0' style='border:0' allowfullscreen='')
          .col-sm-12.section-t8
            .row
              .col-md-7
                form.php-email-form(action='/api/feedback' method='post' role='form')
                  .row
                    .col-md-6.mb-3
                      .form-group
                        input.form-control.form-control-lg.form-control-a(type='text' name='name' placeholder='Your Name' required='')
                    .col-md-6.mb-3
                      .form-group
                        input.form-control.form-control-lg.form-control-a(name='email' type='email' placeholder='Your Email' required='')
                    .col-md-12.mb-3
                      .form-group
                        input.form-control.form-control-lg.form-control-a(type='text' name='subject' placeholder='Subject' required='')
                    .col-md-12
                      .form-group
                        textarea.form-control(name='message' cols='45' rows='8' placeholder='Message' required='')
                    .col-md-12.my-3
                      .mb-3
                        .loading Loading
                        .error-message
                        .sent-message Your message has been sent. Thank you!
                    .col-md-12.text-center
                      button.btn.btn-a(type='submit') Send Message
              .col-md-5.section-md-t3
                .icon-box.section-b2
                  .icon-box-icon
                    span.bi.bi-envelope
                  .icon-box-content.table-cell
                    .icon-box-title
                      h4.icon-title Say Hello
                    .icon-box-content
                      p.mb-1
                        | Email.
                        span.color-a gacherujames@yahoo.com
                      p.mb-1
                        | Phone.
                        span.color-a 020 221 1083
                      p.mb-1
                        | P.O. Box.
                        span.color-a 6574 - 00100, Nairobi, Kenya
                .icon-box.section-b2
                  .icon-box-icon
                    span.bi.bi-geo-alt
                  .icon-box-content.table-cell
                    .icon-box-title
                      h4.icon-title Find us in
                    .icon-box-content
                      p.mb-1
                        | Suite 503, 5<sup>th</sup> floor, Vedic House
                        br
                        | Mama Ngina Street, Nairobi
                        br
                        |  Kenya.
                .icon-box
                  .icon-box-icon
                    span.bi.bi-share
                  .icon-box-content.table-cell
                    .icon-box-title
                      h4.icon-title Social networks
                    .icon-box-content
                      .socials-footer
                        ul.list-inline
                          li.list-inline-item
                            a.link-one(href='#')
                              i.bi.bi-facebook(aria-hidden='true')
                          li.list-inline-item
                            a.link-one(href='#')
                              i.bi.bi-twitter(aria-hidden='true')
                          li.list-inline-item
                            a.link-one(href='#')
                              i.bi.bi-instagram(aria-hidden='true')
                          li.list-inline-item
                            a.link-one(href='#')
                              i.bi.bi-linkedin(aria-hidden='true')
    // End Contact Single
    // End #main
    include includes/footer.pug
