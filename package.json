  "private": true,
  "scripts": {
    "test": "export NODE_ENV=test && mocha --require babel-register --inspect test/**/*.js --exit",
    "dev": "nodemon --exec babel-node --presets @babel/preset-env --inspect  ./src/bin/www",
    "build": "babel ./src --out-dir dist --source-maps --copy-files",
