    "admin-bro": "^4.0.1",
    "babel-preset-env": "^1.7.0",
    "cloudinary": "^1.25.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^10.0.0",
    "express": "~4.16.1",
    "express-formidable": "^1.2.0",
    "express-hbs": "^2.4.0",
    "express-session": "^1.17.2",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.12.11",
    "mongoose-autopopulate": "^0.14.0",
